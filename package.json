{
  "name": "ai-research-orchestrator",
  "private": true,
  "version": "0.4.2",
  "description": "Client-only React PWA for PubMed/arXiv literature review with multi-provider AI (or heuristic fallback) and a local IndexedDB knowledge base.",
  "type": "module",
  "packageManager": "pnpm@11.13.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22.12.0",
      "onFail": "error"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "pnpm run icons && vite build && node scripts/generate-deployment-artifacts.mjs && node scripts/patch-csp-hashes.mjs",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test src/test/e2e/a11y.spec.ts",
    "test:e2e:pwa": "playwright test --config=playwright.pwa.config.ts",
    "test:e2e:report": "playwright show-report",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0 --cache --cache-location node_modules/.cache/eslint/.eslintcache",
    "check:fast": "pnpm run typecheck && pnpm run lint && pnpm run format:check && pnpm run check:conflict-markers",
    "check:conflict-markers": "node scripts/check-no-conflict-markers.mjs",
    "format": "prettier --write --cache --cache-location node_modules/.cache/prettier/.prettiercache \"src/**/*.{ts,tsx,css}\" \"*.{json,md}\" \".github/**/*.md\"",
    "format:check": "prettier --check --cache --cache-location node_modules/.cache/prettier/.prettiercache \"src/**/*.{ts,tsx,css}\" \"*.{json,md}\" \".github/**/*.md\"",
    "icons": "node scripts/generate-pwa-icons.mjs",
    "workbox:copy": "node scripts/copy-workbox.mjs",
    "prepare": "husky",
    "predeploy": "pnpm run build",
    "analyze": "ANALYZE=1 vite build && node scripts/generate-deployment-artifacts.mjs && node scripts/patch-csp-hashes.mjs",
    "bundle:budget": "node scripts/check-bundle-budget.mjs",
    "check:no-cdn-scripts": "node scripts/check-no-cdn-scripts.mjs",
    "check:workbox-vendor-drift": "node scripts/check-workbox-vendor-drift.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:docs-drift": "node scripts/check-docs-drift.mjs",
    "check:coverage-floors": "node scripts/check-coverage-floors.mjs",
    "check:log-redaction": "node scripts/check-log-redaction.mjs",
    "check:audit-ignore-paths": "node scripts/check-audit-ignore-paths.mjs",
    "check:csp-endpoint-drift": "node scripts/check-docs-drift.mjs --csp-endpoint",
    "check:agent-eval": "vitest run src/lib/agentEval.test.ts src/lib/agentEval.adversarial.test.ts src/lib/heuristicEval.test.ts src/lib/liveOrchestratorEval.test.ts",
    "i18n:ratchet": "node scripts/check-i18n-ratchet.mjs",
    "csp:hashes": "node scripts/patch-csp-hashes.mjs",
    "test:lighthouse": "pnpm run build && node scripts/run-lighthouse.mjs"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix --max-warnings 0 --no-warn-ignored",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.112.3",
    "@google/genai": "^2.13.0",
    "@reduxjs/toolkit": "^2.12.0",
    "@tanstack/react-virtual": "^3.14.10",
    "dexie": "^4.4.2",
    "dexie-react-hooks": "^4.4.0",
    "dompurify": "^3.4.12",
    "framer-motion": "^12.38.0",
    "jspdf": "^4.2.0",
    "lucide-react": "^1.34.0",
    "marked": "^18.0.11",
    "openai": "^7.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-redux": "^9.3.0",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^9.16.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.2.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.5.4",
    "eslint": "^9.16.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.4.1",
    "prettier": "^3.9.6",
    "rollup-plugin-visualizer": "^7.0.1",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3",
    "terser": "^5.51.2",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.65.0",
    "vite": "8.1.5",
    "vitest": "^4.1.10",
    "workbox-cacheable-response": "7.0.0",
    "workbox-core": "7.0.0",
    "workbox-expiration": "7.0.0",
    "workbox-precaching": "7.0.0",
    "workbox-routing": "7.0.0",
    "workbox-strategies": "7.0.0",
    "workbox-sw": "7.0.0"
  }
}
