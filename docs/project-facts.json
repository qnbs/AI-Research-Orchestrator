  "e2e": {
    "mainWorkflowPath": ".github/workflows/e2e.yml",
    "mainJobBlocking": true,
    "crossBrowserWorkflowPath": ".github/workflows/e2e-cross-browser.yml",
    "crossBrowserAdvisory": false,
    "ciSpecPaths": [
      "src/test/e2e/smoke.spec.ts",
      "src/test/e2e/agent-flow.spec.ts",
      "src/test/e2e/dialog-a11y.spec.ts",
      "src/test/e2e/keyboard-focus.spec.ts",
      "src/test/e2e/skip-to-content.spec.ts",
      "src/test/e2e/journal-hub.spec.ts",
      "src/test/e2e/provider-flow.spec.ts"
    ],
    "separateBlockingSpecs": ["src/test/e2e/a11y.spec.ts"]
  },
  "ci": {
    "claudeCodeReviewWorkflow": false,
    "claudeOnDemandWorkflow": true,
    "branchGovernancePath": "docs/ci-branch-governance.md",
    "cancelInProgressOnPullRequestOnly": true,
    "concurrencyGuardedWorkflows": [
      ".github/workflows/deploy.yml",
      ".github/workflows/e2e.yml",
      ".github/workflows/e2e-cross-browser.yml",
      ".github/workflows/a11y.yml",
      ".github/workflows/security.yml"
    ]
  },
  "staticAnalysis": {
    "eslintBlocking": true,
    "deepsourceJavaScriptEnabled": false,
    "deepsourceJavaScriptAdvisory": true
  },
  "adr": {
    "indexPath": "docs/adr/README.md",
    "minNumberedRecords": 20
  },
  "providers": {
    "ids": ["gemini", "openai", "anthropic", "ollama", "heuristic"],
    "defaultId": "gemini",
    "defaultModels": {
      "gemini": "gemini-2.5-flash",
      "openai": "gpt-5",
      "anthropic": "claude-sonnet-4-5",
      "ollama": "llama3.1:8b",
      "heuristic": "local"
    }
  },
  "deployment": {
    "model": "configurable-base-path",
    "defaultBasePath": "/AI-Research-Orchestrator/",
    "defaultSiteOrigin": "https://qnbs.github.io",
    "envVars": ["VITE_BASE_PATH", "VITE_SITE_ORIGIN"]
  },
  "release": {
    "policyPath": "docs/release-policy.md",
    "packageVersion": "0.4.1",
    "dexieSchemaVersion": 7,
    "swCacheVersion": "v1"
  },
  "sourceIdentifiers": ["pmid", "pmc", "doi", "arxiv"],
  "forbiddenReadmePhrases": [
    "Every AI assertion is inextricably linked to a verified PubMed ID",
    "Jede KI-Aussage ist untrennbar mit einer verifizierten PubMed-ID",
    "Nothing is ever sent to a server",
    "Nichts wird jemals an einen Server gesendet",
    "zero-knowledge architecture",
    "Zero-Knowledge-Architektur",
    "Production_Ready",
    "Gemini_Pro",
    "Gemini 3 Pro",
    "never sent to any server"
  ],
  "forbiddenAgentsPhrases": [
    "That job is `continue-on-error: true`, so its green badge alone doesn't prove 0 failures"
  ]
}
